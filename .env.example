# 감사조서 자가검토 — .env.example (cp .env.example .env 후 키 입력)

AI_PROVIDER=openai
OPENAI_API_KEY=sk-your-key-here
OPENAI_MODEL=gpt-4o-mini

# HANUL_DB_PATH=/Users/you/Desktop/Hanul DB
ALLOW_MANUAL_MATERIALITY=true
FSS_FOCUS_ISSUES_YEAR=2026
FSS_FOCUS_ISSUES_LISTED=국외매출채권,재고자산평가손실,투자부동산,충당부채우발부채
FALLBACK_TO_HARDCODED_PROCEDURES=true

# 사내 배포 (도메인 연결 전 테스트용 — 비워두면 서버 IP로 자동 안내)
APP_BASE_URL=
STREAMLIT_SERVER_PORT=8505
# 교수님 공개 URL 고정 파일: .tunnel.url.stable (sync_public_url.sh)
